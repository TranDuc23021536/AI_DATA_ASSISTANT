# Copy file này thành .env và điền API key của bạn
# cp .env.example .env

# Groq API Key (Free tier, đăng ký tại https://console.groq.com)
# Groq free tier: 30 requests/min, đủ để demo
GROQ_API_KEY=your_groq_api_key_here

# Optional: OpenAI (nếu muốn dùng GPT thay vì Llama)
# OPENAI_API_KEY=your_openai_api_key_here
